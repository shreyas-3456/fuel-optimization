{
  "info": {
    "name": "Fuel Route API",
    "_postman_id": "d73fbf2d-b1f8-45df-92b9-8dddb3d68f7b",
    "description": "Postman collection for testing the Django fuel route API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('base_url')) {",
          "  pm.collectionVariables.set('base_url', 'http://127.0.0.1:8000');",
          "}",
          "console.log('Calling Fuel Route API at ' + pm.collectionVariables.get('base_url'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response is JSON', function () {",
          "  pm.response.to.have.header('Content-Type');",
          "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Route Fuel - Text Locations",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const data = pm.response.json();",
              "",
              "pm.test('Returns route, fuel stops, and total cost', function () {",
              "  pm.expect(data.route.geojson.type).to.eql('LineString');",
              "  pm.expect(data.fuel_stops.length).to.be.above(0);",
              "  pm.expect(data.total_fuel_cost).to.be.a('number');",
              "});",
              "",
              "pm.test('Uses one GraphHopper call', function () {",
              "  pm.expect(data.external_api_calls.graphhopper_total).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start_location\": \"Chicago, IL\",\n  \"finish_location\": \"Dallas, TX\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/route-fuel/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route-fuel",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "Route Fuel - Coordinate Start",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('This request supplies start coordinates, so only finish needs OSM geocoding.');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const data = pm.response.json();",
              "",
              "pm.test('Uses one OpenStreetMap geocode call', function () {",
              "  pm.expect(data.external_api_calls.openstreetmap_geocoding).to.eql(1);",
              "});",
              "",
              "pm.test('Uses one GraphHopper call', function () {",
              "  pm.expect(data.external_api_calls.graphhopper_total).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start_location\": {\n    \"lat\": 41.8781,\n    \"lng\": -87.6298,\n    \"label\": \"Chicago, IL\"\n  },\n  \"finish_location\": \"Dallas, TX\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/route-fuel/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route-fuel",
            ""
          ]
        }
      },
      "response": []
    }
  ]
}
